/* War of the East — C&C-style layout.
   Canvas #view fills the frame. Overlaid by:
   #res  (top resource strip) · #command (RIGHT vertical build panel + tabs)
   #hud-bottom (bottom-left minimap + selection panel). */

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }
body {
  background: #0a0d0a;
  color: #d8d2b0;
  font-family: "Trebuchet MS", "MS Gothic", sans-serif;
  font-size: 13px;
  -webkit-user-select: none; user-select: none;
}

#game { position: absolute; inset: 0; outline: none; }

#view {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  display: block;
  background: #2a2e22;
  image-rendering: pixelated;
  cursor: crosshair;
}

/* ---------- top resource strip ---------- */
#res {
  position: absolute; top: 0; left: 0; right: 0; height: 26px;
  display: flex; align-items: center; gap: 14px;
  padding: 0 12px;
  background: linear-gradient(#1c2016cc, #10130cd0);
  border-bottom: 1px solid #4a4a2c;
  z-index: 6; pointer-events: none;
}
#res .ri { display: flex; align-items: baseline; gap: 4px; font-size: 12px; color: #9a9468; white-space: nowrap; }
#res .ri b { font-size: 14px; font-weight: bold; color: #e8e0b0; }
#res .ri.low b { color: #ff7a4a; }
#res .ri.paused, #res .ri.over { margin-left: auto; color: #ffd24a; font-size: 12px; letter-spacing: 1px; }
#res .ri.over b { color: #ffd24a; }

/* ---------- command panel (RIGHT side, tabbed) ---------- */
#command {
  position: absolute; top: 30px; right: 8px; bottom: 8px; width: 206px;
  display: flex; flex-direction: column;
  background: linear-gradient(#171a10e6, #0d0f08e6);
  border: 1px solid #4a4a2c;
  border-radius: 3px;
  box-shadow: 0 0 18px rgba(0,0,0,.5);
  z-index: 6; overflow: hidden;
}
#cmdTabs {
  display: grid; grid-template-columns: 1fr 1fr; gap: 3px;
  padding: 4px;
  border-bottom: 1px solid #3a3a22;
  background: #101309;
}
.cmd-tab {
  position: relative;
  display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
  gap: 1px;
  padding: 5px 6px 4px;
  border: 1px solid #2e2e1c;
  border-radius: 2px;
  background: #1c2014;
  cursor: pointer;
  line-height: 1.1;
}
.cmd-tab .ct-label { font-size: 11px; font-weight: bold; letter-spacing: .5px; color: #c9c39a; }
.cmd-tab kbd {
  position: absolute; top: 2px; right: 4px;
  font-size: 9px; color: #7a7450;
  border: 1px solid #3a3a22; border-radius: 2px; padding: 0 3px;
}
.cmd-tab:hover { background: #242818; border-color: #5a5a34; }
.cmd-tab.on {
  background: linear-gradient(#3a3c1e, #2a2c14);
  border-color: #ffd24a;
}
.cmd-tab.on .ct-label { color: #ffd24a; }
.cmd-tab.on kbd { color: #ffd24a; border-color: #7a5a1c; }

#cmdBody { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 5px; }

/* ---------- build/unit/research cards ---------- */
.card {
  display: flex; align-items: center; gap: 6px;
  padding: 3px 4px; margin: 2px 0;
  border: 1px solid #2e2e1c;
  background: #1c2014;
  border-radius: 2px;
  cursor: pointer;
}
.card:hover { background: #262a1a; border-color: #5a5a34; }
.card.off { opacity: .42; }
.card.active { border-color: #ffd24a; background: #2e2e14; box-shadow: 0 0 6px rgba(255,210,74,.3) inset; }
.card.done { opacity: .55; cursor: default; border-style: dashed; }

.thumb {
  width: 36px; height: 36px; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: #10130a;
  border: 1px solid #34341e; border-radius: 2px;
  font-weight: bold; font-size: 13px; color: #9a9468;
}
.thumb img { width: 34px; height: 34px; image-rendering: pixelated; }
.thumb.rs { color: #ffd24a; font-size: 12px; }
.thumb.air { border-color: #3a5a6a; }
.thumb.veh { border-color: #4a5a3a; }

.cbody { flex: 1; min-width: 0; }
.cbody .nm { font-size: 12px; color: #e9e2bd; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cbody .meta { font-size: 9.5px; color: #8a8458; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px; line-height: 1.3; }
.cbody .meta em.no { color: #ff9a6a; font-style: italic; }
.cost { font-size: 10px; color: #9a9468; white-space: nowrap; margin-left: 2px; }
.lock { display: inline-block; margin-left: 4px; font-size: 9px; color: #ffd24a; border: 1px solid #7a5a1c; border-radius: 2px; padding: 0 3px; vertical-align: middle; }
.dim { opacity: .5; font-size: 11px; padding: 6px; text-align: center; }

/* ---------- bottom-left: minimap + selection ---------- */
#hud-bottom {
  position: absolute; left: 8px; bottom: 8px;
  display: flex; flex-direction: column; gap: 6px;
  z-index: 6;
}
#mmwrap {
  width: 180px; height: 180px;
  border: 2px solid #4a4a2c;
  background: #0a0d0a;
  box-shadow: 0 0 14px rgba(0,0,0,.5);
}
#minimap { width: 100%; height: 100%; display: block; cursor: crosshair; image-rendering: pixelated; }

#sel {
  width: 180px;
  background: linear-gradient(#171a10e6, #0d0f08e6);
  border: 1px solid #4a4a2c;
  border-radius: 3px;
  padding: 5px 6px;
  font-size: 11px;
}
.selhead { display: flex; justify-content: space-between; gap: 6px; font-weight: bold; color: #e9e2bd; font-size: 12px; }
.selhead .tag { color: #8a8458; font-size: 9px; text-transform: uppercase; letter-spacing: 1px; align-self: center; }
.selrow { margin-top: 2px; color: #c9c39a; line-height: 1.35; }
.selrow.dim { color: #8a8458; }
.selhint { color: #8a8458; font-size: 10px; line-height: 1.5; }
.selhint b { color: #c9c39a; }
.selbtn {
  margin-top: 4px;
  font-size: 10px; padding: 2px 8px;
  background: #2c2c14; color: #e9e2bd;
  border: 1px solid #7a5a1c; border-radius: 2px;
  cursor: pointer;
}
.selbtn:hover { background: #3a3c1e; border-color: #ffd24a; }

/* ---------- scrollbars ---------- */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-thumb { background: #3a3a22; border-radius: 4px; }
::-webkit-scrollbar-track { background: #12150c; }

/* ---------- game over ---------- */
#over {
  position: absolute; inset: 0; z-index: 90;
  display: flex; align-items: center; justify-content: center;
  background: rgba(8, 10, 5, 0.72);
  backdrop-filter: blur(2px);
}
#over.hidden { display: none; }
.over-card {
  background: linear-gradient(180deg, #20241a, #14180f);
  border: 2px solid #7a5a1c; border-radius: 6px;
  padding: 34px 56px; text-align: center;
  box-shadow: 0 0 40px rgba(0, 0, 0, 0.7);
}
.over-title {
  font-size: 44px; font-weight: 700; letter-spacing: 6px; margin-bottom: 10px;
}
.over-title.win { color: #ffd24a; text-shadow: 0 0 18px rgba(255, 210, 74, 0.5); }
.over-title.lose { color: #d94b3a; text-shadow: 0 0 18px rgba(200, 70, 50, 0.5); }
.over-sub { color: #cfc9a4; font-size: 15px; margin-bottom: 22px; }
.overbtn {
  background: #2c2c14; color: #ffd24a;
  border: 1px solid #7a5a1c; border-radius: 3px;
  padding: 10px 26px; font-size: 14px; letter-spacing: 2px; cursor: pointer;
}
.overbtn:hover { background: #3a3c1e; border-color: #ffd24a; }
